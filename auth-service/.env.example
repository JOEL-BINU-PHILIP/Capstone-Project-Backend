# ================================================
# FILE: .env.example
# ================================================
# Copy this file to .env and fill in your values
# DO NOT commit .env file to version control

# MongoDB Connection
MONGO_URI=mongodb://localhost:27017/auth_db

# JWT Secret (Generate with: openssl rand -base64 32)
JWT_SECRET=your-very-long-and-secure-secret-key-minimum-32-characters-for-production

# Email Configuration
# For Gmail: Enable 2FA and create App Password
# For SendGrid: Use API key as password with username "apikey"
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-specific-password
MAIL_FROM=noreply@homeservice.com

# Application URL
APP_BASE_URL=http://localhost:8080

# Optional: For development with Mailtrap
# MAILTRAP_USERNAME=your-mailtrap-username
# MAILTRAP_PASSWORD=your-mailtrap-password
